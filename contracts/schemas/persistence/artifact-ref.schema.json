{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biomarker.local/persistence/artifact-ref.schema.json",
  "title": "BioMarker ArtifactRef",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bucket",
    "object_key",
    "sha256",
    "size_bytes"
  ],
  "properties": {
    "bucket": {
      "type": "string",
      "minLength": 1
    },
    "object_key": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "content_type": {
      "type": "string"
    }
  }
}
