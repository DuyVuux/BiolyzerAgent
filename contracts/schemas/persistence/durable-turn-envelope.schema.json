{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biomarker.local/persistence/durable-turn-envelope.schema.json",
  "title": "BioMarker DurableTurnEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_digest",
    "record"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record": {
      "$ref": "durable-turn-record.schema.json"
    }
  }
}
