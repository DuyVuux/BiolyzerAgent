{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biomarker.local/persistence/canonical-transcript-entry.schema.json",
  "title": "BioMarker CanonicalTranscriptEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "turn_id",
    "entry_key",
    "selected_physical_call_id",
    "payload_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "entry_key": {
      "type": "string",
      "minLength": 1
    },
    "selected_physical_call_id": {
      "type": "string",
      "minLength": 1
    },
    "payload_ref": {
      "$ref": "artifact-ref.schema.json"
    }
  }
}
