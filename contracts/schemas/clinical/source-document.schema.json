{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biomarker.local/clinical/source-document.schema.json",
  "title": "BioMarker SourceDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "media_type",
    "integrity",
    "provenance",
    "retention_class"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_system_label",
        "received_at"
      ],
      "properties": {
        "source_system_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "external_locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "retention_class": {
      "type": "string",
      "enum": [
        "ephemeral_development",
        "external_authoritative",
        "unspecified"
      ]
    }
  }
}
