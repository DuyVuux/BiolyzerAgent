{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biomarker.local/analysis/reasoning-candidate.schema.json",
  "title": "BioMarker ReasoningCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "requested_actions",
    "statements"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "candidate_id": {
      "type": "string"
    },
    "requested_actions": {
      "type": "array",
      "items": {
        "enum": [
          "web_search",
          "retrieval",
          "tool_call",
          "dynamic_schema",
          "dynamic_model"
        ]
      }
    },
    "statements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      }
    }
  },
  "$defs": {
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_id",
        "statement_class",
        "text",
        "inference_mode",
        "assertion_strength",
        "clinical_refs",
        "evidence_claim_refs",
        "conflict_disclosed",
        "missing_context_acknowledged"
      ],
      "properties": {
        "statement_id": {
          "type": "string"
        },
        "statement_class": {
          "enum": [
            "measured_fact",
            "derived_fact",
            "evidence_context",
            "bounded_interpretation",
            "limitation",
            "physician_question",
            "diagnosis",
            "treatment_recommendation",
            "medication_change",
            "dosage_change",
            "emergency_triage"
          ]
        },
        "text": {
          "type": "string"
        },
        "inference_mode": {
          "enum": [
            "none",
            "association",
            "uncertainty",
            "diagnostic",
            "therapeutic",
            "triage",
            "patient_specific_causal"
          ]
        },
        "assertion_strength": {
          "enum": [
            "direct_source",
            "deterministic",
            "evidence_supported",
            "uncertain",
            "definitive"
          ]
        },
        "clinical_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence_claim_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "derivation_ref": {
          "type": "string"
        },
        "conflict_disclosed": {
          "type": "boolean"
        },
        "missing_context_acknowledged": {
          "type": "boolean"
        }
      }
    }
  }
}
